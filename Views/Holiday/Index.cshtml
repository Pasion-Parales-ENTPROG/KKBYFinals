
@model List<KKBYFinals.Models.Holiday>

@{
    ViewData["Title"] = "Holiday Calendar";
}

<div class="container mt-4">

    <h2 class="mb-2">Philippines Holiday Calendar</h2>
    <p class="text-muted">View public holidays for the selected year.</p>

    <form asp-controller="Holiday" asp-action="Index" method="get"
          class="row g-2 mb-4">

        <div class="col-md-3">
            <label class="form-label">Select Year</label>
            <select name="year" class="form-select">
                @for (int y = DateTime.Now.Year - 1;
                      y <= DateTime.Now.Year + 5; y++)
                {
                    if (y == (int)ViewBag.Year)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                View Holidays
            </button>
        </div>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Holidays - @ViewBag.Year</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Holiday Name</th>
                        <th>Local Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var holiday in Model.OrderBy(h => h.Date))
                        {
                            <tr>
                                <td>@holiday.Date.ToString("MMMM dd, yyyy")</td>
                                <td>@holiday.Date.ToString("dddd")</td>
                                <td>@holiday.Name</td>
                                <td>@holiday.LocalName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No holiday records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
