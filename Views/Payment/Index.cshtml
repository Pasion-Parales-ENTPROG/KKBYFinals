@model IEnumerable<KKBYFinals.Models.Payment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="form-group mb-3">
    <input type="text" id="searchBox" class="form-control"
           placeholder="Search payments..." />
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Method)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="paymentRows">
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Method)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Amount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaymentDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PaymentId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.PaymentId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.PaymentId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
    // Start searching whenever the user types
    document.getElementById("searchBox").addEventListener("input", function () {

        // Get the search keyword and convert it to lowercase
        const text = this.value.toLowerCase();

        // Check each payment record in the table
        document.querySelectorAll("#paymentRows tr").forEach(function (row) {

            // Combine all payment information into one searchable text
            const rowText = (row.cells[0].textContent + " " +
                             row.cells[1].textContent + " " +
                             row.cells[2].textContent + " " +
                             row.cells[3].textContent + " " +
                             row.cells[4].textContent).toLowerCase();

            // Display only the records that match the search
            row.style.display = rowText.includes(text) ? "" : "none";
        });
    });
</script>
}