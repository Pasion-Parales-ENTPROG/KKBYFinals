@model IEnumerable<KKBYFinals.Models.Order>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="form-group mb-3">
    <input type="text" id="searchBox" class="form-control"
           placeholder="Search orders..." />
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="orderRows">
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.OrderId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.OrderId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
    // Activate filtering whenever the search input changes
    document.getElementById("searchBox").addEventListener("input", function () {

        // Convert the search text to lowercase
        const text = this.value.toLowerCase();

        // Check each order displayed in the table
        document.querySelectorAll("#orderRows tr").forEach(function (row) {

            // Combine the order information for searching
            const rowText = (row.cells[0].textContent + " " +
                             row.cells[1].textContent + " " +
                             row.cells[2].textContent + " " +
                             row.cells[3].textContent + " " +
                             row.cells[4].textContent).toLowerCase();

            // Display matching orders and hide non-matching orders
            row.style.display = rowText.includes(text) ? "" : "none";
        });
    });
</script>
}